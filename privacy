.hero {
  position: relative;
  color: #fff;
  padding: 120px 0 80px;
  text-align: center;
  margin-top: 70px;
  overflow: hidden;
  background: transparent !important; /* kill the old gradient */
  isolation: isolate;                 /* contain z-index stacking */
}

.hero > .container {
  position: relative; /* keep text above bg layers */
  z-index: 1;
}

/* Blurred banner image + fallback gradient */
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  /* First layer: image (shown if it loads). Second: gradient fallback */
  background-image: url("banner.png"), linear-gradient(135deg, #1e2a5e 0%, #2c4aa0 100%);
  background-size: cover, 100% 100%;
  background-position: center, center;
  background-repeat: no-repeat, no-repeat;

  filter: blur(14px);
  transform: scale(1.08);  /* hide blur edge */
  z-index: 0;
  pointer-events: none;
}

/* Optional dark tint for readability */
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(16, 26, 64, 0.45);
  z-index: 0;              /* same layer as ::before; ::after paints on top */
  pointer-events: none;
}



