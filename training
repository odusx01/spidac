}

.tech-slide img {
  max-width: 100px;
  max-height: 60px;
  object-fit: contain;
}

/* Keyframes for sliding */
@keyframes slide {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%); /* moves half of the track (because you duplicated slides) */
  }
}

/* Responsive: show fewer logos on smaller screens */
@media (max-width: 992px) {
  .tech-slide {
    flex: 0 0 calc(100% / 4);
  }
}
@media (max-width: 768px) {
  .tech-slide {
    flex: 0 0 calc(100% / 3);
  }
}
@media (max-width: 480px) {
